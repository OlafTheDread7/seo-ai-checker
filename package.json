{
  "name": "seo-ai-checker",
  "version": "1.0.0",
  "description": "Scan any website for SEO and AI-searchability (GEO/AEO), get a score and an actionable report.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:local": "node --env-file=.env server.js",
    "dev:local": "node --watch --env-file=.env server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.19.2"
  }
}
