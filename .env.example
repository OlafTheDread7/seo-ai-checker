# Environment config for the Search Visibility Checker.
# Copy this to ".env" for LOCAL development — as written, it gives you the
# ungated local tool (no lead capture, no rate limits).
# For the PUBLIC deployment, DON'T rely on this file — set these as Railway
# environment variables instead.

# Lead-gating, rate limiting, and the hire-us CTA. Leave this OFF (commented)
# for local use; set PUBLIC_MODE=true ONLY on the public Railway instance.
# PUBLIC_MODE=true

# Web3Forms access key — captured lead emails are forwarded here.
# Get a free key at https://web3forms.com tied to jake@rvadigitalworks.com
WEB3FORMS_KEY=

# Perplexity API key — enables the AI-visibility check (Agent API).
# Without it, that feature is hidden and the rest of the tool works normally.
# Get a key at https://console.perplexity.ai
PERPLEXITY_API_KEY=

# Optional — the model used for the AI-visibility check. Defaults to perplexity/sonar.
# PERPLEXITY_MODEL=perplexity/sonar

# PORT is set automatically by Railway; leave unset locally to default to 3000.
# PORT=3000
