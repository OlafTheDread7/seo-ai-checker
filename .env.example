# Public deployment config for the Search Visibility Checker
# Copy to .env locally, or set these as environment variables on Railway.

# Turn on lead-gating, rate limiting, and the hire-us CTA (public instance only).
PUBLIC_MODE=true

# Web3Forms access key — captured lead emails are forwarded here.
# Get a free key at https://web3forms.com tied to jake@rvadigitalworks.com
WEB3FORMS_KEY=

# PORT is set automatically by Railway; leave unset locally to default to 3000.
# PORT=3000
